<div class="page-title"><h1>Şifre Değiştir</h1></div>
@if (Ctx.User != null && Ctx.User.MustChangePassword)
{
  <div class="alert warn">Hesabınız geçici şifre ile açıldı. Devam etmek için yeni bir şifre belirleyin.</div>
}
<div class="card narrow">
  <div class="bd">
    <form method="post" action="/sifre">
      @H.Raw(H.CsrfField(Ctx))
      <div class="mb"><label for="current">Mevcut şifre</label><input type="password" id="current" name="current" required autocomplete="current-password"></div>
      <div class="mb"><label for="new">Yeni şifre</label><input type="password" id="new" name="new" required minlength="8" maxlength="128" autocomplete="new-password">
        <div class="hint">En az 8 karakter; en az bir harf ve bir rakam içermelidir.</div></div>
      <div class="mb"><label for="confirm">Yeni şifre (tekrar)</label><input type="password" id="confirm" name="confirm" required minlength="8" maxlength="128" autocomplete="new-password"></div>
      <button class="btn" type="submit">Şifreyi Güncelle</button>
    </form>
  </div>
</div>
