@{
    var rows = (List<Row>)ViewBag.Rows;
}
<div class="page-title"><div><h1>Kullanıcı Hesapları</h1><div class="sub">Hesapları yalnızca koordinatör açar. Öğrenci hesapları öğrenci eklenirken otomatik oluşturulur.</div></div></div>
<div class="card"><div class="hd"><h3>Personel hesabı oluştur</h3></div><div class="bd">
  <form method="post" action="/koordinator/kullanicilar" class="form-row">@H.Raw(H.CsrfField(Ctx))
    <div><label>Kullanıcı adı</label><input type="text" name="username" required pattern="[a-z0-9._\-]{3,60}" maxlength="60"></div>
    <div><label>Ad soyad</label><input type="text" name="full_name" required maxlength="150"></div>
    <div><label>E-posta</label><input type="email" name="email" maxlength="150"></div>
    <div><label>Rol</label><select name="role"><option value="bolum_baskani">Bölüm Başkanı</option><option value="koordinator">Koordinatör</option></select></div>
    <div class="w-auto"><button class="btn" type="submit">Oluştur</button></div>
  </form>
</div></div>
<div class="card"><div class="bd flush"><div class="table-wrap"><table class="tbl">
  <thead><tr><th>Kullanıcı adı</th><th>Ad soyad</th><th>Rol</th><th>Son giriş</th><th>Durum</th><th></th></tr></thead>
  @foreach (var u in rows)
  {
    var active = u.B("is_active");
    var locked = u.Dt("locked_until") is DateTime lu && lu > Clock.Now();
    <tr class="@(active ? "" : "dim")">
      <td><code>@u.S("username")</code></td>
      <td>@if (!u.IsNull("student_id")) {<a href="/koordinator/ogrenci/@u.L("student_id")">@u.S("full_name")</a>} else {@u.S("full_name")}</td>
      <td>@L.Get(L.Role, u.S("role"))</td><td class="small nowrap">@H.Dt(u.Dt("last_login_at"))</td>
      <td>@(active ? H.Badge("aktif") : H.Badge("iptal", "Pasif"))@if (locked) {<text> </text>@H.Badge("kritik", "Kilitli")}@if (u.B("must_change_password")) {<text> <span class="badge b-amber">Geçici şifre</span></text>}</td>
      <td><div class="actions">
        @H.PostBtn(Ctx, "Şifre sıfırla", "/koordinator/kullanicilar/" + u.L("id") + "/sifre", null, "out", u.S("username") + " için yeni geçici şifre üretilsin mi?")
        @if (u.L("id") != Ctx.User!.Id) {@H.PostBtn(Ctx, active ? "Pasifleştir" : "Aktifleştir", "/koordinator/kullanicilar/" + u.L("id") + "/durum", null, active ? "danger" : "ok", "Hesap durumu değiştirilsin mi?")}
      </div></td>
    </tr>
  }
</table></div></div></div>
